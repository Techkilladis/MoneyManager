{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@design/*": ["src/design/*"],
      "@database/*": ["src/database/*"],
      "@domain/*": ["src/domain/*"],
      "@services/*": ["src/services/*"],
      "@components/*": ["src/components/*"],
      "@utils/*": ["src/utils/*"],
      "@types/*": ["src/types/*"]
    }
  },
  "exclude": [
    "node_modules",
    "modules/local-ai/android/src/main/cpp/llama.cpp/examples"
  ]
}
