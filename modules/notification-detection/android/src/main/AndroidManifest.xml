<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.moneymanager.notification">

    <!-- Notification Listener Service permission -->
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" />
    <!-- Lets the app show the system "allow background activity" prompt so
         OEM battery savers don't kill the listener (auto-capture reliability). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application>
        <!-- Notification Listener Service -->
        <service
            android:name=".MoneyManagerNotificationListenerService"
            android:label="@string/notification_listener_service_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Home-screen widget: today's spend + quick add -->
        <receiver
            android:name=".widget.SpendWidgetProvider"
            android:exported="false"
            android:label="@string/mm_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mm_spend_widget_info" />
        </receiver>
    </application>

</manifest>
