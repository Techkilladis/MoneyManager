{
  "expo": {
    "name": "Money Manager",
    "slug": "MoneyManagerExpo52",
    "scheme": "moneymanager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.suriy.moneymanager",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "./modules/notification-detection/plugin.js",
      "./plugins/withReleaseSigning.js",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F6FA",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0D17"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#4F46E5"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Money Manager to use Face ID to unlock the app."
        }
      ],
      "expo-font"
    ],
    "description": "Track UPI spending automatically. Budgets, splits, recurring bills and private on-device insights.",
    "backgroundColor": "#0B0D17",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "794dc62b-9f69-4790-8eaa-668231a10bc6"
      }
    },
    "owner": "zenova1109"
  }
}
